# Database Configuration
# For local: postgresql://user:password@localhost:5432/database_name
# For Docker Compose deployment, use the db service hostname:
# postgresql://teamtrack_user:teamtrack_pass@db:5432/teamtrack_db
DATABASE_URL=postgresql://team_track_user:team_track_pass@127.0.0.1:5432/team_track_db
POSTGRES_USER=teamtrack_user
POSTGRES_PASSWORD=teamtrack_pass
POSTGRES_DB=teamtrack_db

# Application Secrets (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Public URLs
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Remote Deployment
GITHUB_OWNER=your-github-owner
APP_NAME=team-track
IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=teamtrack_prod
NGINX_SERVER_NAME=team.elaramedical.com
NGINX_CERT_NAME=team.elaramedical.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Email Configuration (Choose one provider)
# Option 1: Resend (Recommended)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# Option 2: SendGrid
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.your_api_key_here
# EMAIL_FROM=noreply@yourdomain.com

# Option 3: SMTP (Use Base64 encoding for password if needed)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your_base64_encoded_password
# SMTP_SECURE=false
# EMAIL_FROM=your-email@gmail.com
